{
  "version": "2.1.0",
  "turns": 40,
  "actionPointsPerTurn": 4,
  "monthsPerSemester": 5,
  "examTurns": [5, 10, 15, 20, 25, 30, 35, 40],
  "randomEventBaseChance": 0.45,
  "recentEventCooldown": 12,
  "attributePointTotal": 20,
  "attributeKeys": ["knowledge", "social", "health", "money"],
  "healthRestrictThreshold": 3,
  "warningFailedCourses": 3,
  "affinityMax": 100,
  "endingPriorityOrder": "asc",

  "monthlyIncome": 2000,
  "monthlyExpense": 2000,
  "debtThreshold": -3000,
  "debtCooldownTurns": 6,
  "attributeClamp": { "knowledge": [0, 99], "social": [0, 99], "health": [0, 99], "money": null },

  "exam": {
    "subjects": ["高等数学", "大学英语", "专业核心", "思想政治"],
    "subjectTopics": { "专业核心": "major", "高等数学": "basics", "大学英语": "basics", "思想政治": "humanities" },
    "topicRules": [
      { "topic": "basics", "words": ["英语", "体育", "微积分", "线性代数", "大学物理", "概率统计", "数学", "物理", "化学"] },
      { "topic": "humanities", "words": ["形势与政策", "思想道德", "马克思主义", "毛泽东思想", "近现代史", "军事理论", "职业发展", "就业指导", "文学", "历史", "哲学"] }
    ],
    "defaultTopic": "major",
    "subjectSatiety": 12,
    "subjectBonus": 30,
    "fluctuation": 0.12,
    "passLine": 60,
    "base": 50,
    "knowledgeWeight": 1.0,
    "studyBonusPerAction": 3,
    "difficulty": 10,
    "note": "单门 score = round((60 + 分科进度加成(开根号递减) + 学识兜底 + (健康-60)×0.1) × (1±fluctuation))，夹[60,100]；分科进度按学习地点主题累计（major/basics/humanities），学识仅兜底，永不挂科。课程名→主题的解析顺序：subjectTopics[课程名] 显式映射 → topicRules 关键词 → defaultTopic（默认 major），见 academy.resolveTopic"
  },

  "gpaTable": [
    { "min": 90, "gpa": 4.0 },
    { "min": 85, "gpa": 3.7 },
    { "min": 80, "gpa": 3.3 },
    { "min": 76, "gpa": 3.0 },
    { "min": 73, "gpa": 2.7 },
    { "min": 70, "gpa": 2.3 },
    { "min": 66, "gpa": 2.0 },
    { "min": 63, "gpa": 1.7 },
    { "min": 61, "gpa": 1.3 },
    { "min": 60, "gpa": 1.0 }
  ],

  "thesis": {
    "knowledgeWeight": 1.0,
    "gpaWeight": 25,
    "passLine": 60
  },

  "threeTierBonus": {
    "thresholds": [10, 20],
    "tiers": ["low", "mid", "high"],
    "bonus": { "low": 0, "mid": 1, "high": 2 },
    "note": "属性分档加成：<10 → +0，10–19 → +1，≥20 → +2"
  },

  "idleDecay": {
    "everyTurns": 4,
    "resetPerYear": true,
    "knowledge": { "actions": ["study"], "amount": 3 },
    "health": { "actions": ["exercise", "rest"], "amount": 2 },
    "note": "连续 N 周没有对应行动则扣属性：学识 -3（学习 +2/次，4 周不学约少 8 点成长再扣 3）；健康 -2（休息 +3、锻炼 +2，另受学习/社交扣血影响）。resetPerYear=true 表示每学年（10 回合）重新计数。"
  },

  "note": "数值为初值，期末公式已切换为：单门 score = round(学识 × (1 ± 波动))，绩点查 gpaTable；平衡需经 40 回合模拟调优"
}
